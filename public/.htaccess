RewriteEngine On

# Real files/directories (static assets, sw.js, manifest.json, /ru/, ...) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean-path search, e.g. /kacchapa or /ru/kacchapa: serve the SPA shell, query string
# (and any ?q= it already had) is passed through automatically. extra.js turns the path
# segment into ?q= on load.
RewriteRule ^ru/[^/]+/?$ ru/index.html [L]
RewriteRule ^[^/]+/?$ index.html [L]

# The service worker must control the whole app, not just /static/ where the file lives.
# Without this header a registration with { scope: '/' } is rejected (see extra.js).
<Files "sw.js">
  Header set Service-Worker-Allowed "/"
  Header set Cache-Control "no-cache"
</Files>
